SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=require
DATABASE_PROVIDER=neon
VEDOY_API_ENV=development
TELNYX_API_KEY=KEY_example
TELNYX_PUBLIC_KEY=base64_spki_public_key
TELNYX_MESSAGING_PROFILE_ID=00000000-0000-0000-0000-000000000000
VEDOY_GROSS_MARGIN_BPS=2000
VEDOY_CREDIT_USD_MICROS=10000
TELNYX_SMS_PROVIDER_USD_MICROS=0
# Required before customer webhook endpoints can be created. Use 32+ random characters.
VEDOY_WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-server-secret
# Optional server-side agent worker. When absent, agent runs remain blocked rather than using a hidden provider.
VEDOY_AGENT_RUNNER_URL=https://your-agent-runner.example.com/runs
