SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=require
DATABASE_PROVIDER=neon
VEDOY_API_ENV=development
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=replace-with-api-key-secret
# Used only to validate signed Twilio webhooks.
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VEDOY_GROSS_MARGIN_BPS=2000
VEDOY_CREDIT_USD_MICROS=10000
TWILIO_SMS_PROVIDER_USD_MICROS=0
TWILIO_NUMBER_UPFRONT_USD_MICROS=0
TWILIO_NUMBER_MONTHLY_USD_MICROS=0
VEDOY_PUBLIC_URL=https://vedoy-dev-portal.vercel.app
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VEDOY_CHAT_REQUEST_CREDITS=5
VEDOY_EMBEDDING_REQUEST_CREDITS=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_SCALE=
# Required before customer webhook endpoints can be created. Use 32+ random characters.
VEDOY_WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-server-secret
# Optional server-side agent worker. When absent, agent runs remain blocked rather than using a hidden provider.

# Wolt Drive merchant keys are server-only; contact Wolt Drive for sandbox credentials.
WOLT_DRIVE_ENV=development
WOLT_DRIVE_API_KEY=
WOLT_DRIVE_VENUE_ID=
# Mandatory explicit opt-in before any real Wolt production quote requests.
WOLT_DRIVE_LIVE_QUOTES_ENABLED=false
